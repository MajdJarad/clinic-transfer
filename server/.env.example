# Server
PORT=3001
NODE_ENV=development

# Database (SQLite for local development)
DATABASE_URL="file:./dev.db"
# Production on a host with a persistent disk (e.g. mounted at /data): use an ABSOLUTE path, e.g.
#   DATABASE_URL="file:/data/clinic.db"
# The container creates it from the bundled database on first start and then keeps it.
# A relative path (the default) lives inside the container and is reset on every deploy/restart.

# Auth
JWT_SECRET="change-me-in-production-please"
JWT_EXPIRES_IN="7d"

# Google Maps Platform key. Enable: Maps JavaScript API, Routes API, Places API (New).
# Used for the map, routes, place search and traffic.
GOOGLE_MAPS_API_KEY=""
# Optional: Map ID of a vector map (Google Cloud Console -> Map Management). Enables heading-up + tilt in navigation.
GOOGLE_MAP_ID=""
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# WhatsApp: no API integration. We only generate wa.me deep links.
# Country code used to normalize patient phone numbers, e.g. 966 for Saudi Arabia.
DEFAULT_COUNTRY_CODE="966"

# --- Map defaults: Istanbul, Turkey ---
MAP_CENTER_LAT="41.0082"
MAP_CENTER_LNG="28.9784"
MAP_CENTER_ZOOM="11"

# Optional: Traccar GPS tracking server for real vehicle/phone tracking.
# https://www.traccar.org/  (self-hosted, open source)
# Prefer a permanent API token; otherwise use user/password (basic auth).
TRACCAR_URL="http://localhost:8082"
TRACCAR_TOKEN=""
TRACCAR_USER=""
TRACCAR_PASSWORD=""
