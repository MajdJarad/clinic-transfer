# Server
PORT=3001
NODE_ENV=development

# Database (SQLite for local development)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-me-in-production-please"
JWT_EXPIRES_IN="7d"

# Google (fill after creating Cloud project)
GOOGLE_MAPS_API_KEY=""
GOOGLE_CALENDAR_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# WhatsApp: no API integration. We only generate wa.me deep links.
# Country code used to normalize patient phone numbers, e.g. 966 for Saudi Arabia.
DEFAULT_COUNTRY_CODE="966"

# --- Real map (OpenStreetMap / Leaflet) - no API key required ---
# Map defaults to Istanbul, Turkey.
MAP_CENTER_LAT="41.0082"
MAP_CENTER_LNG="28.9784"
MAP_CENTER_ZOOM="11"

# Real routing engine (OSRM). Public demo by default; use your own for production.
OSRM_URL="https://router.project-osrm.org"
# Address search / geocoding (Nominatim / OpenStreetMap).
NOMINATIM_URL="https://nominatim.openstreetmap.org"

# Optional: TomTom traffic-flow tiles (free tier, best Istanbul coverage).
# https://developer.tomtom.com/   (Traffic API -> flow tiles)
TOMTOM_API_KEY=""

# Optional: Traccar GPS tracking server for real vehicle/phone tracking.
# https://www.traccar.org/  (self-hosted, open source)
# Prefer a permanent API token; otherwise use user/password (basic auth).
TRACCAR_URL="http://localhost:8082"
TRACCAR_TOKEN=""
TRACCAR_USER=""
TRACCAR_PASSWORD=""
